<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bug2_distributed</name>
  <version>1.0.0</version>
  <description>
    Distributed 3-Node Architecture for Bug2 Maze Navigation:
    - Node 1: GoToGoal Action Server
    - Node 2: WallFollow Action Server (LiDAR PD)
    - Node 3: Bug2 Coordinator (Brain & State Machine)
  </description>
  <maintainer email="salman@todo.todo">salman</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>create3_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

